{
  "name": "dsh-desktop",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "productName": "dsh-work",
  "main": "electron/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "runtime": "node scripts/run-with-project-node.mjs print",
    "postinstall": "node scripts/run-with-project-node.mjs node scripts/bootstrap.mjs",
    "setup": "node scripts/run-with-project-node.mjs node scripts/bootstrap.mjs --force",
    "doctor": "node scripts/run-with-project-node.mjs node scripts/doctor.mjs",
    "vendor-runtime:source": "node scripts/run-with-project-node.mjs node scripts/fetch-vendor-runtime-source.mjs",
    "audit:prod": "node scripts/run-with-project-node.mjs node scripts/audit-production.mjs",
    "release:check": "node scripts/run-with-project-node.mjs node scripts/release-safety.mjs --scope all",
    "release:check:report": "node scripts/run-with-project-node.mjs node scripts/release-safety.mjs --scope all --allow-blockers",
    "release:check:mac:static": "node scripts/run-with-project-node.mjs node scripts/release-safety.mjs --scope macos --static",
    "release:check:win:static": "node scripts/run-with-project-node.mjs node scripts/release-safety.mjs --scope windows --static",
    "release:verify:mac": "node scripts/run-with-project-node.mjs node scripts/release-safety.mjs --scope macos --app release/mac-arm64/dsh-work.app",
    "release:verify:mac:x64": "node scripts/run-with-project-node.mjs node scripts/release-safety.mjs --scope macos --app release/mac/dsh-work.app",
    "release:verify:win": "node scripts/run-with-project-node.mjs node scripts/release-safety.mjs --scope windows --app release/win-unpacked/dsh-work.exe",
    "check:deps": "node scripts/run-with-project-node.mjs node scripts/bootstrap.mjs --check",
    "dev": "node scripts/run-with-project-node.mjs node scripts/dev.mjs",
    "dev:renderer": "node scripts/run-with-project-node.mjs npm --prefix renderer run dev -- --host 127.0.0.1",
    "dev:electron": "node scripts/run-with-project-node.mjs npm --prefix electron run dev",
    "typecheck": "node scripts/run-with-project-node.mjs npm --prefix renderer run typecheck",
    "build:desktop-assets": "node scripts/run-with-project-node.mjs npm run build:renderer",
    "build:renderer": "node scripts/run-with-project-node.mjs npm --prefix renderer run build:desktop",
    "package:mac:dir": "node scripts/run-with-project-node.mjs npm --prefix electron run package:mac:dir",
    "package:mac:x64:dir": "node scripts/run-with-project-node.mjs npm --prefix electron run package:mac:x64:dir",
    "package:mac": "node scripts/run-with-project-node.mjs npm --prefix electron run package:mac",
    "package:mac:x64": "node scripts/run-with-project-node.mjs npm --prefix electron run package:mac:x64",
    "package:win:dir": "node scripts/run-with-project-node.mjs npm --prefix electron run package:win:dir",
    "package:win": "node scripts/run-with-project-node.mjs npm --prefix electron run package:win",
    "test:renderer": "node scripts/run-with-project-node.mjs npm --prefix renderer test",
    "test:unit": "node scripts/run-with-project-node.mjs node --import ./eval/tests/setup.mjs --test --test-concurrency=1 eval/tests/*.test.mjs",
    "test": "npm run test:project",
    "test:project": "node scripts/run-with-project-node.mjs npm run test:project:runtime",
    "test:project:runtime": "node scripts/bootstrap.mjs --check && npm --prefix renderer run typecheck && npm --prefix renderer test && node --import ./eval/tests/setup.mjs --test --test-concurrency=1 eval/tests/*.test.mjs",
    "eval": "node scripts/run-with-project-node.mjs node eval/run.mjs",
    "eval:pr": "node scripts/run-with-project-node.mjs node eval/run.mjs --suite pr",
    "eval:ui": "node scripts/run-with-project-node.mjs node eval/run.mjs --suite ui",
    "eval:model-nightly": "node scripts/run-with-project-node.mjs node eval/run.mjs --suite model-nightly --use-configured-models",
    "eval:dsh-alignment": "node scripts/run-with-project-node.mjs node eval/run.mjs --suite dsh-alignment --use-configured-models",
    "eval:packaged-faults": "node scripts/run-with-project-node.mjs node eval/packaged-fault-matrix.mjs release/mac-arm64/dsh-work.app",
    "smoke:browser-workspace-ui": "node scripts/run-with-project-node.mjs node eval/browser-workspace-ui-smoke.mjs",
    "smoke:workbench-tabs-ui": "node scripts/run-with-project-node.mjs node eval/workbench-tabs-ui-smoke.mjs",
    "smoke:project-files-search-ui": "node scripts/run-with-project-node.mjs node eval/project-files-search-ui-smoke.mjs",
    "smoke:project-artifacts-ui": "node scripts/run-with-project-node.mjs node eval/project-artifacts-ui-smoke.mjs",
    "smoke:office-artifacts-ui": "node scripts/run-with-project-node.mjs node eval/office-artifacts-ui-smoke.mjs",
    "smoke:canvas-workspace-ui": "node scripts/run-with-project-node.mjs node eval/canvas-workspace-ui-smoke.mjs",
    "smoke:message-actions-ui": "node scripts/run-with-project-node.mjs node eval/message-actions-ui-smoke.mjs",
    "smoke:plan-status-ui": "node scripts/run-with-project-node.mjs node eval/plan-status-ui-smoke.mjs",
    "smoke:global-chat-memory-ui": "node scripts/run-with-project-node.mjs node eval/global-chat-memory-ui-smoke.mjs",
    "smoke:chat-context-ui": "node scripts/run-with-project-node.mjs node eval/chat-context-ui-smoke.mjs",
    "smoke:web-image-ui": "node scripts/run-with-project-node.mjs node eval/web-image-ui-smoke.mjs",
    "smoke:local-site-ui": "node scripts/run-with-project-node.mjs node eval/local-site-ui-smoke.mjs",
    "smoke:native-multi-agent-ui": "node scripts/run-with-project-node.mjs node eval/native-multi-agent-ui-smoke.mjs"
  }
}
