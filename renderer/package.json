{
  "name": "dsh-renderer",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node ../scripts/run-with-project-node.mjs exec vite --mode serve-dev",
    "build": "npm run build:app && npm run build:dsh-client",
    "build:app": "node ../scripts/run-with-project-node.mjs exec vite build --mode desktop",
    "build:dsh-client": "node ../scripts/run-with-project-node.mjs exec vite build --config vite.dsh-client.config.ts --mode desktop",
    "build:desktop": "npm run build:app && npm run build:dsh-client",
    "preview": "node ../scripts/run-with-project-node.mjs exec vite preview",
    "typecheck": "node ../scripts/run-with-project-node.mjs exec tsc --noEmit",
    "lint": "node ../scripts/run-with-project-node.mjs exec eslint . --ext .ts,.tsx",
    "test": "node ../scripts/run-with-project-node.mjs exec vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-sql": "^6.10.0",
