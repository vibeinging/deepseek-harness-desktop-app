{
  "name": "@deepseek-ai/dsh-product-bridge",
  "description": "Session-scoped dsh-work product capabilities for the current DSH Web profile",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshWork": {
    "product": "./product.json"
  },
  "files": [
    "src/index.js",
    "product.json",
    "cordis.patch.yml",
