  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.2"
  }
